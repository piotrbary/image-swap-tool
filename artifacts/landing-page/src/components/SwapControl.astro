---
/**
 * SwapControl — the paired arrow buttons that copy an image between two
 * panels. Vertical by default (collapses to horizontal on mobile).
 *
 * The buttons carry data-swap attributes so the page script can attach
 * handlers and toggle their disabled state.
 */
interface Props {
  orientation?: "vertical" | "horizontal";
  class?: string;
}

const { orientation = "vertical", class: className = "" } = Astro.props;
const cls = `is-swap is-swap--${orientation} ${className}`.trim();
---

<div class={cls}>
  <button
    type="button"
    class="is-swap__btn"
    data-swap="forward"
    title="Skopiuj Obraz 1 → Obraz 2"
    aria-label="Skopiuj Obraz 1 do Obrazu 2"
    disabled>&rsaquo;</button>
  <div class="is-swap__divider"></div>
  <button
    type="button"
    class="is-swap__btn"
    data-swap="back"
    title="Skopiuj Obraz 2 → Obraz 1"
    aria-label="Skopiuj Obraz 2 do Obrazu 1"
    disabled>&lsaquo;</button>
</div>
