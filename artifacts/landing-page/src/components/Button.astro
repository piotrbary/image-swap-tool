---
interface Props {
  variant?:
    | "primary"
    | "secondary"
    | "outline"
    | "ghost"
    | "destructive"
    | "link";
  size?: "default" | "sm" | "lg" | "icon";
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "default",
  class: className = "",
  ...rest
} = Astro.props;

const cls = `is-btn is-btn--${variant} is-btn--${size} ${className}`.trim();
---

<button type="button" class={cls} {...rest}><slot /></button>
